# HTTP
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events

# Workers
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
CONSUMER_MAX_RECEIVE_COUNT=5
CONSUMER_WAIT_TIME_SECONDS=5
CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true

# Observability
LOG_LEVEL=info
